{
        "version": "2.0.0",
        "tasks": [
                {
                        "label": "compile file c++",
                        "type": "shell",
                        "command": "clang++",
                        "args": [
                                "-std=c++17",
                                "-stdlib=libc++",
                                "${file}",
                                "-c",
                                "-o",
                                "./bin/objects/${fileBasenameNoExtension}.o"
                        ]
                },
                {
                        "label": "build",
                        "type": "shell",
                        "command": "clang++",
                        "args": [
                                "-std=c++17",
                                "-stdlib=libc++",
                                "./bin/objects/**.o",
                                "-o",
                                "./bin/App.out"
                        ]
                },
                {
                        "label": "Run",
                        "type": "shell",
                        "command": "./bin/App.out"
                },
                {
                        "label": "All build c++",
                        "type": "shell",
                        "command": "clang++",
                        "args": [
                                "-std=c++17",
                                "-stdlib=libc++",
                                "./src/**.cpp",
                                "-o",
                                "./bin/App.out"
                        ],
                        "problemMatcher": []
                },
                {
                        "label": "run + all build",
                        "type": "shell",
                        "command": "./bin/App.out",
                        "dependsOn": [
                                "All build c++"
                        ],
                        "group": {
                                "kind": "build",
                                "isDefault": false
                        }
                },
                {
                        "type": "cppbuild",
                        "label": "C/C++: clang build active file",
                        "command": "/usr/bin/clang",
                        "args": [
                                "-fcolor-diagnostics",
                                "-fansi-escape-codes",
                                "-g",
                                "${file}",
                                "-o",
                                "${fileDirname}/${fileBasenameNoExtension}"
                        ],
                        "options": {
                                "cwd": "${fileDirname}"
                        },
                        "problemMatcher": [
                                "$gcc"
                        ],
                        "group": {
                                "kind": "build",
                                "isDefault": true
                        },
                        "detail": "Task generated by Debugger."
                }
        ]
}